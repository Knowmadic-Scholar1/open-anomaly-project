{
  "name": "open-anomaly-project",
  "private": true,
  "version": "0.1.0-oap",
  "description": "Open Anomaly Project — citizen-science anomaly reporting on a God's Eye View geospatial substrate.",
  "type": "module",
  "license": "MIT",
  "author": "Open Anomaly Project contributors",
  "homepage": "https://github.com/Knowmadic-Scholar1/open-anomaly-project#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Knowmadic-Scholar1/open-anomaly-project.git"
  },
  "bugs": {
    "url": "https://github.com/Knowmadic-Scholar1/open-anomaly-project/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "open-anomaly-project",
    "citizen-science",
    "cesium",
    "3d-globe",
    "geospatial",
    "anomaly",
    "gods-eye-view"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:oap": "node --test src/oap/oap.store.test.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}
